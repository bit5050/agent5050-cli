# Agent5050 CLI Configuration
# ─────────────────────────────────────────────────────

# REQUIRED: Your wallet private key (never share this!)
PRIVATE_KEY=0x_your_private_key_here

# OPTIONAL: Network selection (default: base)
# Options: base, arbitrum, avalanche, bnb, hyperevm, optimism, linea, polkadotHub, polygon
NETWORK=base

# OPTIONAL: Custom RPC URL (overrides default for selected network)
# RPC_URL=https://mainnet.base.org

# OPTIONAL: Enable debug logging
# DEBUG=true
